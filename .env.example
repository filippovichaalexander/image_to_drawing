APP_ENV=development
PORT=8000
MAX_UPLOAD_MB=50
# stub = OpenCV only | full = YOLO + PaddleOCR
AI_MODE=full
INSTALL_FULL_AI=1
# Writable caches inside the container (non-root user)
# HOME=/app/data
# PADDLEOCR_HOME=/app/data/.paddleocr
# Photo alignment: ORB by default; auto C3Po when models/C3Po.pth (~10GB) is present
# USE_C3_ALIGN=0   # force ORB even if C3Po.pth exists
HOST_UID=1000
HOST_GID=1000
